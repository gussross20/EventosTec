<!-- Registro section -->
<section id="registro" class="registration-section">
    <div class="reg-wrap">
        <div class="reg-badge"><span class="bi bi-person-plus"></span>&nbsp; Registro</div>
        <div class="reg-card">
            <div class="reg-section">
                <label class="input-label">Tipo de Participante *</label>
                <div class="participant-options">
                    <label class="participant-option">
                        <input type="radio" name="participant" value="alumno"
                               @onchange="@(() => CambiarTipo(true))"
                               checked="@IsAlumno" />
                        Alumno
                    </label>
                    <label class="participant-option">
                        <input type="radio" name="participant" value="invitado"
                               @onchange="@(() => CambiarTipo(false))"
                               checked="@(!IsAlumno)" />
                        Invitado
                    </label>
                </div>
            </div>
            @if (IsAlumno)
            {
                <AlumnoForm />
            }
            else
            {
                <InvitadoForm />
            }
        </div>
    </div>
</section>

