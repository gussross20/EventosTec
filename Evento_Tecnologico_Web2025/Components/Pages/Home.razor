@page "/"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Inicio</PageTitle>

<style>
.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: linear-gradient(135deg,#1e3a8a 0%,#6d28d9 60%);
    background-size: cover;
    text-align: center;
    padding: 6rem 1rem 4rem;
    position: relative;
}
.hero .container {
    max-width: 900px;
}
/* Top-right horizontal nav inside hero */
.hero-nav {
    position: absolute;
    top: 18px;
    right: 24px;
    display: flex;
    gap: 28px;
    align-items: center;
    font-weight: 500;
}
.hero-nav a {
    color: rgba(255,255,255,0.95);
    text-decoration: none;
    padding: 10px 6px;
    transition: opacity .15s ease;
}
.hero-nav a:hover { opacity: 0.85; }
@@media (max-width: 768px) { .hero-nav { display: none; } }

h1.title {
    font-family: 'Segoe UI', Roboto, Arial, sans-serif;
    font-weight: 700;
    /* Reduced maximum size and narrower responsive scaling */
    font-size: clamp(1.6rem, 5vw, 3.2rem);
    line-height: 1.02;
    margin: 0 0 1rem 0;
    letter-spacing: 1px;
    word-break: break-word;
}
@@media (min-width:1200px) { h1.title { font-size: 4rem; } }
@@media (max-width: 768px) { h1.title { font-size: 1.8rem; line-height:1.12 } }
.sub {
    font-size: 1.25rem;
    opacity: 0.95;
    margin-bottom: 1.75rem;
}
.badges {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 2rem;
}
.badge-box {
    background: rgba(255,255,255,0.08);
    padding: 0.75rem 1rem;
    border-radius: 12px;
    display: inline-flex;
    gap: .5rem;
    align-items: center;
}
.cta-btn {
    background: #1677ff;
    border: none;
    color: white;
    padding: 0.9rem 2rem;
    border-radius: 10px;
    font-size: 1.05rem;
}

/* Información module styles */
.info-section {
    background: #f7fafc;
    padding: 4rem 1rem;
}
.info-wrap { max-width: 1200px; margin: 0 auto; }
.info-title { text-align:center; font-weight:600; margin-bottom:0.5rem; }
.info-sub { text-align:center; color: #6b7280; margin-bottom:2.5rem; }
.cards-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1.5rem; }
.card-feature { background: white; border-radius: 12px; box-shadow: 0 6px 18px rgba(15,23,42,0.06); overflow: hidden; }
.card-top { height: 150px; background-size: cover; background-position: center; position: relative; }
.card-top::after { content: ''; position:absolute; left:0; right:0; top:0; bottom:0; background: linear-gradient(180deg, rgba(0,0,0,0.18), rgba(0,0,0,0)); }
.icon-circle { position: absolute; left:50%; transform: translateX(-50%); bottom: -22px; width:56px; height:56px; border-radius:50%; background: #ffffff; display:flex; align-items:center; justify-content:center; box-shadow: 0 6px 14px rgba(2,6,23,0.12); }
.icon-circle span { font-size:1.25rem; }
/* icon color variants */
.icon-circle.conf { color: #0e63ff; }
.icon-circle.tall { color: #a855f7; }
.icon-circle.cult { color: #ec4899; }
.icon-circle.soc { color: #10b981; }
.card-body { padding: 2.2rem 1.2rem 1.6rem 1.2rem; }
.card-body h4 { margin: 0 0 0.6rem 0; font-weight:600; }
.card-body p { margin:0; color:#6b7280; font-size:0.95rem; line-height:1.6 }

@@media (max-width: 992px) { .cards-grid { grid-template-columns: repeat(2,1fr); } }
@@media (max-width: 576px) { .cards-grid { grid-template-columns: 1fr; } .card-top { height:120px } }

/* Panelistas section styles */
.panelistas-section { background: linear-gradient(180deg,#f8fbff 0%, #eef6fb 100%); padding: 4rem 1rem; }
.panelistas-wrap { max-width:1200px;margin:0 auto; }
.panel-badge { display:inline-flex; align-items:center; gap:.6rem; background:#fff2e8; padding:.5rem 1rem; border-radius:30px; box-shadow:0 6px 18px rgba(2,6,23,0.06); color:#d4702a; margin:0 auto 1rem; }
.panelists-title { text-align:center; font-weight:600; margin-bottom:.25rem; }
.panelistas-sub { text-align:center; color:#6b7280; margin-bottom:2rem; }
.profiles-row { display:grid; grid-template-columns: repeat(3,1fr); gap:1.5rem; margin-bottom:2.5rem; }
.profile-card { background:white; border-radius:12px; overflow:hidden; box-shadow: 0 6px 18px rgba(2,6,23,0.06); display:flex; flex-direction:column; }
.profile-media { height:450px; background-size:cover; background-position:center; position:relative; }
.profile-generation { position:absolute; left:16px; bottom:12px; background:#ff7a18; color:white; padding:6px 12px; border-radius:20px; font-size:0.9rem; box-shadow:0 6px 12px rgba(15,23,42,0.12); }
.profile-body { padding:1.2rem; }
.profile-name { margin:0 0 .35rem 0; font-weight:700; }
.profile-role { margin:0; color:#0b63f6; text-decoration:none; }
.profile-org { display:flex; gap:.5rem; align-items:center; color:#6b7280; margin-top:.65rem; font-size:0.95rem; }
.profile-desc { margin-top:0.9rem; color:#475569; font-size:0.95rem; line-height:1.5 }
.profile-link { display:inline-flex; align-items:center; gap:.5rem; margin-top:0.9rem; color:#0b63f6; text-decoration:none; }
/* Highlight panel box */
.panel-highlight-wrap { display:block; margin: 1.5rem 0; }
.panel-highlight {
    /* removed colored background and heavy shadow to match the simple layout */
    max-width: none;
    background: transparent;
    border-radius: 0;
    padding: 0;
    position: relative;
    box-shadow: none;
    margin-bottom: 1.5rem;
}
.panel-highlight::before { content:''; display:none; }
.panel-highlight h4 {
    text-align: left;
    margin: 0 0 0.5rem 0;
    color: #0f172a; /* dark heading color */
    font-weight: 600;
    font-size: 1.5rem;
}
.panel-highlight .panel-time {
    text-align: left;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: #111827;
}
.panel-highlight p {
    text-align: left;
    color: #475569;
    margin: 0;
    max-width: 900px;
}

    .hero-header {
        background-color: rgba(14, 78, 213, 0.85);
        padding: 0.8rem 2rem;
    }

    .hero-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .hero-logos {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        .hero-logos img {
            height: 50px;
        }

    .hero-nav {
        display: flex;
        gap: 1.5rem;
    }

        .hero-nav a {
            color: white;
            text-decoration: none;
            font-weight: 600;
            transition: 0.2s;
        }

            .hero-nav a:hover {
                text-decoration: underline;
                opacity: 0.85;
            }

    /* Opcional: centrar contenido principal */
    .hero .container {
        text-align: center;
        color: white;
        padding: 4rem 1rem;
    }


/* Registro section styles */
.registration-section { background: linear-gradient(180deg,#f8fbff 0%, #f7f2fb 100%); padding: 3.5rem 1rem 6rem; }
.reg-wrap { max-width: 900px; margin: 0 auto; }
.reg-badge { display:inline-flex; align-items:center; gap:.6rem; background:#1e63ff; color:white; padding:.5rem 1rem; border-radius:30px; box-shadow:0 6px 18px rgba(2,6,23,0.06); margin:0 auto 1rem; }
.reg-title { text-align:center; font-weight:600; margin-bottom:.25rem; }
.reg-sub { text-align:center; color:#6b7280; margin-bottom:2rem; }
.reg-card { background:white; border-radius:12px; padding:2rem; box-shadow: 0 10px 30px rgba(2,6,23,0.06); }
.reg-form { display:grid; gap:1rem; }
.reg-grid-2 { display:grid; grid-template-columns: 1fr 1fr; gap:1rem; }
.input-field { width:100%; padding:0.9rem 1rem; border-radius:10px; border:1px solid #eef2f7; background:#f6f7f9; outline:none; }
.input-label { display:block; font-weight:600; margin-bottom:.35rem; }
.input-note { font-size:0.9rem; color:#6b7280; }
.reg-section { margin-top:0.5rem; }
.participant-options { display:flex; flex-direction:column; gap:0.8rem; }
.participant-option { display:flex; align-items:center; gap:1rem; padding: .9rem 1rem; border-radius:10px; background:#f7fafc; border:1px solid transparent; }
.participant-option input[type="radio"] { accent-color:#0b63f6; width:18px; height:18px; }
.participant-option.active { border-color:#e6edf9; box-shadow: 0 2px 6px rgba(11,99,246,0.06); }
.reg-submit { margin-top:1rem; background:#07051a; color:white; border:none; padding:0.95rem 1.2rem; border-radius:10px; font-weight:600; width:100%; cursor:pointer; }
.reg-foot { font-size:0.92rem; color:#9aa3b2; margin-top:0.75rem; }

/* Footer styles */
.site-footer { background: #0b1220; color: #d2dbe6; padding: 3.5rem 1rem 2.25rem; }
.footer-wrap { max-width:1200px; margin:0 auto; display:grid; grid-template-columns: repeat(3,1fr); gap:2rem; align-items:start; }
.footer-col h4 { color:#ffffff; margin:0 0 1rem 0; font-size:1.05rem; }
.footer-about p { color:#b6c2d6; line-height:1.6; margin:0 0 1rem 0; }
.footer-social { display:flex; gap:0.6rem; }
.footer-social a { display:inline-flex; align-items:center; justify-content:center; width:34px; height:34px; border-radius:6px; background:transparent; color:#d2dbe6; text-decoration:none; border:1px solid rgba(255,255,255,0.03); }
.footer-contact { color:#b6c2d6; display:flex; flex-direction:column; gap:0.6rem; }
.footer-contact .contact-item { display:flex; gap:0.6rem; align-items:center; }
.footer-links { display:flex; flex-direction:column; gap:0.6rem; }
.footer-links a { color:#cbd9f0; text-decoration:none; }
.footer-links a:hover { text-decoration:underline; }
.footer-hr { height:1px; background: rgba(255,255,255,0.04); margin:1.75rem 0; border-radius:1px; }
.footer-bottom { text-align:center; color:#a9b6ce; font-size:0.95rem; padding-top:0.75rem; }

@@media (max-width: 900px) { .footer-wrap { grid-template-columns: 1fr; } }

/* Programa section styles */
.program-section { padding: 4rem 1rem; background: #fff; }
.program-wrap { max-width: 1100px; margin: 0 auto; }
.program-badge { display:inline-flex; align-items:center; gap:.6rem; background:#e6f0ff; padding:.6rem 1rem; border-radius:999px; box-shadow:0 6px 18px rgba(2,6,23,0.06); margin:0 auto 1rem; }
.program-title { text-align:center; font-weight:500; margin-bottom:.5rem; }
.program-sub { text-align:center; color:#6b7280; margin-bottom:1.5rem; }
.day-tabs { display:flex; gap:1rem; justify-content:center; margin:1.2rem 0 2rem; position: relative; background: transparent; padding:0; border-radius:999px; }
.day-tab { padding:.8rem 1.6rem; border-radius:999px; background: transparent; cursor:pointer; font-weight:600; border: none; color: #111827; text-decoration:none; }
.day-tab.active { background:#ffffff; box-shadow: 0 6px 18px rgba(2,6,23,0.06); }
.timeline { display:flex; flex-direction:column; gap:1rem; }
.event-row { display:grid; grid-template-columns:150px 1fr; gap:1rem; align-items:center; }
.event-time { color:#475569; font-weight:600; padding-left:8px; }
.event-card { background:#f8fbff; padding:1rem 1.25rem; border-radius:8px; box-shadow:none; border-left:6px solid transparent; }
.event-card.conf { border-left-color: #2b8cff; background: #eef7ff; }
.event-card.taller { border-left-color: #8b5cf6; background: #fbf5ff; }
.event-card.panel { border-left-color: #f59e0b; background: #fff7ed; }
.event-card.cultural { border-left-color: #ec4899; background: #fff5f8; }
.event-card.soc { border-left-color: #10b981; background: #f0fff6; }
.event-card.neutral { border-left-color: #cbd5e1; background: #f8fafc; }
.event-title { font-weight:700; margin:0 0 .35rem 0; }
.event-speaker { margin:0; color:#6b7280; }
.legend { display:flex; gap:2rem; justify-content:center; margin-top:2rem; align-items:center; }
.legend-item { display:flex; gap:.6rem; align-items:center; color:#475569 }
.legend-dot { width:14px; height:14px; border-radius:3px; }
.legend-dot.conf { background:#2b8cff }
.legend-dot.tall { background:#8b5cf6 }
.legend-dot.panel { background:#f59e0b }
.legend-dot.cult { background:#ec4899 }
.legend-dot.soc { background:#10b981 }
@@media (max-width:768px) { .event-row { grid-template-columns: 110px 1fr; } .program-wrap { padding:0 1rem } }
@@media (max-width:480px) { .event-row { grid-template-columns: 1fr; } .event-time { padding-left:0; text-align:left; margin-bottom:.5rem } }
</style>

