@page "/programa/{day:int?}"
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavigationManager

@code {
    [Parameter]
    public int? day { get; set; }

    private int activeDay = 1;

    protected override void OnParametersSet()
    {
        activeDay = day ?? 1;
    }
}

<style>
.program-section { padding: 4rem 1rem; background: #fff; }
.program-wrap { max-width: 1100px; margin: 0 auto; }
.program-badge { display:inline-flex; align-items:center; gap:.6rem; background:#e6f0ff; padding:.6rem 1rem; border-radius:999px; box-shadow:0 6px 18px rgba(2,6,23,0.06); margin:0 auto 1rem; }
.program-title { text-align:center; font-weight:600; margin-bottom:.5rem; }
.program-sub { text-align:center; color:#6b7280; margin-bottom:1.5rem; }
.day-tabs { display:flex; gap:1rem; justify-content:center; margin:1.2rem 0 2rem; position: relative; background: transparent; padding:0; border-radius:999px; }
.day-tab { padding:.8rem 1.6rem; border-radius:999px; background: transparent; cursor:pointer; font-weight:600; border: none; color: #111827; text-decoration:none; }
.day-tab.active { background:#ffffff; box-shadow: 0 6px 18px rgba(2,6,23,0.06); }
.timeline { display:flex; flex-direction:column; gap:1rem; }
.event-row { display:grid; grid-template-columns:150px 1fr; gap:1rem; align-items:center; }
.event-time { color:#475569; font-weight:600; padding-left:8px; }
.event-card { background:#f8fbff; padding:1rem 1.25rem; border-radius:8px; box-shadow:none; border-left:6px solid transparent; }
.event-card.conf { border-left-color: #2b8cff; background: #eef7ff; }
.event-card.taller { border-left-color: #8b5cf6; background: #fbf5ff; }
.event-card.panel { border-left-color: #f59e0b; background: #fff7ed; }
.event-card.cultural { border-left-color: #ec4899; background: #fff5f8; }
.event-card.soc { border-left-color: #10b981; background: #f0fff6; }
.event-card.neutral { border-left-color: #cbd5e1; background: #f8fafc; }
.event-title { font-weight:700; margin:0 0 .35rem 0; }
.event-speaker { margin:0; color:#6b7280; }
.legend { display:flex; gap:2rem; justify-content:center; margin-top:2rem; align-items:center; }
.legend-item { display:flex; gap:.6rem; align-items:center; color:#475569 }
.legend-dot { width:14px; height:14px; border-radius:3px; }
.legend-dot.conf { background:#2b8cff }
.legend-dot.tall { background:#8b5cf6 }
.legend-dot.panel { background:#f59e0b }
.legend-dot.cult { background:#ec4899 }
.legend-dot.soc { background:#10b981 }
@@media (max-width:768px) { .event-row { grid-template-columns: 110px 1fr; } .program-wrap { padding:0 1rem } }
@@media (max-width:480px) { .event-row { grid-template-columns: 1fr; } .event-time { padding-left:0; text-align:left; margin-bottom:.5rem } }
</style>

<section class="program-section">
    <div class="program-wrap">
        <div class="program-badge"><span class="bi bi-calendar-event"></span> Agenda del Evento</div>
        <h3 class="program-title">Programa</h3>
        <p class="program-sub">Dos días llenos de aprendizaje, innovación y conexiones</p>

        <div class="day-tabs" role="tablist">
            <NavLink class="day-tab" href="/programa/1" Match="NavLinkMatch.All">Día 1 - 21 de Noviembre</NavLink>
            <NavLink class="day-tab" href="/programa/2" Match="NavLinkMatch.All">Día 2 - 22 de Noviembre</NavLink>
        </div>

        <div class="timeline">
            @if (activeDay == 1)
            {
                <div class="event-row">
                    <div class="event-time">09:00 - 09:30</div>
                    <div class="event-card neutral"><p class="event-title">Registro y Bienvenida</p></div>
                </div>
                <div class="event-row">
                    <div class="event-time">09:30 - 10:30</div>
                    <div class="event-card conf">
                        <p class="event-title">Conferencia Inaugural: El Futuro de la IA</p>
                        <p class="event-speaker">Por: Dr. Ana Martínez</p>
                    </div>
                </div>
                <div class="event-row">
                    <div class="event-time">10:45 - 12:00</div>
                    <div class="event-card taller">
                        <p class="event-title">Taller: Desarrollo con React y Next.js</p>
                        <p class="event-speaker">Por: Carlos Ruiz</p>
                    </div>
                </div>
                <div class="event-row">
                    <div class="event-time">12:00 - 13:30</div>
                    <div class="event-card neutral"><p class="event-title">Almuerzo y Networking</p></div>
                </div>
                <div class="event-row">
                    <div class="event-time">13:30 - 15:00</div>
                    <div class="event-card panel"><p class="event-title">Panel de Egresados: Experiencias y Consejos Profesionales</p></div>
                </div>
                <div class="event-row">
                    <div class="event-time">15:15 - 16:15</div>
                    <div class="event-card conf">
                        <p class="event-title">Conferencia: Cloud Computing y DevOps</p>
                        <p class="event-speaker">Por: María González</p>
                    </div>
                </div>
                <div class="event-row">
                    <div class="event-time">16:30 - 17:30</div>
                    <div class="event-card panel"><p class="event-title">Panel de Discusión: Tecnología y Sociedad</p></div>
                </div>
                <div class="event-row">
                    <div class="event-time">18:00 - 20:00</div>
                    <div class="event-card cultural"><p class="event-title">Evento Cultural: Exposición de Arte Digital</p></div>
                </div>
            }
            else
            {
                <div class="event-row">
                    <div class="event-time">09:00 - 10:00</div>
                    <div class="event-card conf"><p class="event-title">Conferencia: Ciberseguridad en 2025</p><p class="event-speaker">Por: Dr. Roberto Sánchez</p></div>
                </div>
                <div class="event-row">
                    <div class="event-time">10:15 - 11:30</div>
                    <div class="event-card taller"><p class="event-title">Taller: Desarrollo Móvil Multiplataforma</p><p class="event-speaker">Por: Laura Fernández</p></div>
                </div>
                <div class="event-row">
                    <div class="event-time">11:45 - 13:00</div>
                    <div class="event-card conf"><p class="event-title">Conferencia: Blockchain y Web3</p><p class="event-speaker">Por: Pedro Torres</p></div>
                </div>
                <div class="event-row">
                    <div class="event-time">13:00 - 14:30</div>
                    <div class="event-card neutral"><p class="event-title">Almuerzo</p></div>
                </div>
                <div class="event-row">
                    <div class="event-time">14:30 - 15:30</div>
                    <div class="event-card taller"><p class="event-title">Taller: UI/UX Design Thinking</p><p class="event-speaker">Por: Sofía Ramírez</p></div>
                </div>
                <div class="event-row">
                    <div class="event-time">15:45 - 16:45</div>
                    <div class="event-card conf"><p class="event-title">Conferencia de Cierre: Innovación y Emprendimiento</p><p class="event-speaker">Por: Miguel Ángel Díaz</p></div>
                </div>
                <div class="event-row">
                    <div class="event-time">17:00 - 17:30</div>
                    <div class="event-card neutral"><p class="event-title">Ceremonia de Clausura</p></div>
                </div>
                <div class="event-row">
                    <div class="event-time">18:00 - 21:00</div>
                    <div class="event-card soc"><p class="event-title">Evento Social: Cóctel de Networking</p></div>
                </div>
            }
        </div>

        <div class="legend">
            <div class="legend-item"><span class="legend-dot conf"></span> Conferencias</div>
            <div class="legend-item"><span class="legend-dot tall"></span> Talleres</div>
            <div class="legend-item"><span class="legend-dot panel"></span> Panel</div>
            <div class="legend-item"><span class="legend-dot cult"></span> Cultural</div>
            <div class="legend-item"><span class="legend-dot soc"></span> Social</div>
        </div>
    </div>
</section>
